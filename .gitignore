# ==============================================================================
# .gitignore para hexapodo-secundario-firmware
# Excluye repositorios externos, binarios y temporales
# ==============================================================================

# 1. Repositorios externos (Alesky / Primario y Overleaf)
/ros2_ws/
/tesis_overleaf/

# 2. Herramientas y binarios ejecutables
arduino-cli.exe
*.exe
*.dll
*.so
*.dylib
*.bin
*.zip
*.7z
*.tar.gz

# 3. Archivos de compilación y temporales de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 4. Configuración de IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 5. Logs y archivos de depuración
*.log
*.tmp
build/
.pio/
